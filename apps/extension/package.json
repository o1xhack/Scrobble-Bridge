{
  "name": "@scrobble-bridge/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "package:store": "pnpm build && node scripts/package-store.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check --ignore-path ../../.prettierignore ."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/chrome": "^0.2.7",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
