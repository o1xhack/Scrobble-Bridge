{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Scrobble Bridge window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.last.fm/" },
        { "url": "https://www.last.fm/api/auth/*" },
        { "url": "https://scrobble-bridge.o1xhack.com/" },
        { "url": "https://app.o1xhack.com/" },
        { "url": "https://x.com/o1xhack" }
      ]
    }
  ]
}
