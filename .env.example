# Optional official desktop-build credentials. Never commit actual values.
# Both variables must be configured together; omit both for a self-built app
# that lets each user supply their own Last.fm application.
SCROBBLE_LASTFM_API_KEY=
SCROBBLE_LASTFM_SHARED_SECRET=

# Set this after Chrome Web Store assigns the production extension ID.
# The unpacked development extension remains independently allowlisted.
SCROBBLE_PRODUCTION_EXTENSION_ID=
